      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_N8N_TELEGRAM_CRED_ID",
          "name": "Telegram Insurance Triage Bot"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
